<?xml version="1.0" encoding="UTF-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods><li>Humanoid Alien Races</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- HAR defaults omitted isFlesh to true, including inside an existing compatibility block.
             Patch concrete races, preserving explicit opt-outs and existing comp entries. -->
        <li Class="PatchOperationConditional">
          <xpath>/Defs/AlienRace.ThingDef_AlienRace[not(@Abstract="True" or @Abstract="true") and not(alienRace/compatibility/isFlesh[translate(normalize-space(.), "FALSE", "false")="false"])]/comps[not(li[@Class="MoreInjuries.HealthConditions.MoreInjuryCompProperties"]) ]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/AlienRace.ThingDef_AlienRace[not(@Abstract="True" or @Abstract="true") and not(alienRace/compatibility/isFlesh[translate(normalize-space(.), "FALSE", "false")="false"])]/comps[not(li[@Class="MoreInjuries.HealthConditions.MoreInjuryCompProperties"]) ]</xpath>
            <value>
              <li Class="MoreInjuries.HealthConditions.MoreInjuryCompProperties">
                <workerFactoryDef>InjuryWorkerDef</workerFactoryDef>
              </li>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/AlienRace.ThingDef_AlienRace[not(@Abstract="True" or @Abstract="true") and not(alienRace/compatibility/isFlesh[translate(normalize-space(.), "FALSE", "false")="false"])][not(comps)]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/AlienRace.ThingDef_AlienRace[not(@Abstract="True" or @Abstract="true") and not(alienRace/compatibility/isFlesh[translate(normalize-space(.), "FALSE", "false")="false"])][not(comps)]</xpath>
            <value>
              <comps>
                <li Class="MoreInjuries.HealthConditions.MoreInjuryCompProperties">
                  <workerFactoryDef>InjuryWorkerDef</workerFactoryDef>
                </li>
              </comps>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
