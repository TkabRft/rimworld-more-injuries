<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThoughtDef>
    <defName>MorphineHigh</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>MorphineBuildup</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>slight buzz</label>
        <description>Mild relief from morphine.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
      <li>
        <label>warm pudding limbs</label>
        <description>Relaxed and euphoric from morphine.</description>
        <baseMoodEffect>10</baseMoodEffect>
      </li>
      <li>
        <label>pure euphoria</label>
        <description>Strong euphoria from morphine.</description>
        <baseMoodEffect>25</baseMoodEffect>
      </li>
      <li>
        <label>drifting away</label>
        <description>Disturbing effects from excessive morphine.</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
      <defName>MI_MorphineWithdrawal</defName>
      <workerClass>ThoughtWorker_Hediff</workerClass>
      <hediff>MI_MorphineAddiction</hediff>
      <validWhileDespawned>true</validWhileDespawned>
      <stages>
        <li>
          <visible>false</visible>
        </li>
        <li>
          <label>morphine withdrawal</label>
          <description>Morphine withdrawal causes distress.</description>
          <baseMoodEffect>-25</baseMoodEffect>
        </li>
      </stages>
    </ThoughtDef>

</Defs>