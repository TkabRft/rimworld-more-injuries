<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThoughtDef>
    <defName>KetamineHigh</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>KetamineBuildup</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>slight buzz</label>
        <description>Mild relief from ketamine.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
      <li>
        <label>warm pudding limbs</label>
        <description>Relaxed and euphoric from ketamine.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
      <li>
        <label>ketamine relaxation</label>
        <description>Strong euphoria from ketamine.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
      <li>
        <label>terrible hallucinations</label>
        <description>Disturbing hallucinations from excessive ketamine.</description>
        <baseMoodEffect>-15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
      <defName>MI_KetamineWithdrawal</defName>
      <workerClass>ThoughtWorker_Hediff</workerClass>
      <hediff>MI_KetamineAddiction</hediff>
      <validWhileDespawned>true</validWhileDespawned>
      <stages>
        <li>
          <visible>false</visible>
        </li>
        <li>
          <label>ketamine withdrawal</label>
          <description>Ketamine withdrawal causes distress.</description>
          <baseMoodEffect>-15</baseMoodEffect>
        </li>
      </stages>
    </ThoughtDef>


</Defs>