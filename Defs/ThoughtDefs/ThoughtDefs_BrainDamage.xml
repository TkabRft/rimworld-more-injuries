<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThoughtDef>
    <defName>LostAbilityToSpeak</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>BrainDamage_LanguageAphasia</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>word-finding difficulty</label>
        <description>Frustrated by difficulty finding words.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>fragmented speech</label>
        <description>Distressed by fragmented speech.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>non-fluent</label>
        <description>Struggles to communicate basic ideas.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
      <li>
        <label>barely verbal</label>
        <description>Distressed by being barely able to speak.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
      <li>
        <label>completely nonverbal</label>
        <description>Distressed by the complete loss of speech.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>LostMotorFunction</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>BrainDamage_MotorDysfunction</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>clumsy</label>
        <description>Frustrated by clumsiness.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>shaky and unsteady</label>
        <description>Distressed by shaking and unsteady movement.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>struggling to control my body</label>
        <description>Distressed by poor control of movement.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
      <li>
        <label>near-paralyzed</label>
        <description>Distressed by near-total loss of movement.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
      <li>
        <label>trapped in a failing body</label>
        <description>Severely distressed by dependence on others for basic movement.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>LostVisualRecognition</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>BrainDamage_VisualAgnosia</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>things look unfamiliar</label>
        <description>Unsettled by difficulty recognizing familiar objects.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>misrecognizing people and objects</label>
        <description>Distressed by misidentifying people and objects.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>faces blur together</label>
        <description>Distressed by difficulty recognizing faces.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
      <li>
        <label>nothing makes visual sense</label>
        <description>Distressed by severe loss of visual recognition.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>ConfusedAndDisoriented</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>BrainDamage_Confusion</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>disoriented</label>
        <description>Unsettled by occasional confusion.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>forgetting simple things</label>
        <description>Frustrated by frequent forgetfulness.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>losing track of time</label>
        <description>Distressed by losing track of time and place.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
      <li>
        <label>memories feel distant</label>
        <description>Distressed by fading memories.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
      <li>
        <label>losing sense of self</label>
        <description>Severely distressed by loss of memory and identity.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>