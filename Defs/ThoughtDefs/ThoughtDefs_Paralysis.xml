<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThoughtDef>
    <defName>Paralyzed</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>SpinalCordParalysis</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>numbness and tingling</label>
        <description>Unsettled by numbness and tingling.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>limited mobility</label>
        <description>Frustrated by limited movement.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
      <li>
        <label>complete paralysis</label>
        <description>Severely distressed by complete paralysis.</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>