    <thingClass>ThingWithComps</thingClass>
    <label>thoracoscope</label>
    <description>Surgical equipment required for advanced collapsed-lung repair.</description>
    <graphicData>
      <texPath>Thing/Thoracoscope</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>10</stackLimit>
    <drawGUIOverlay>true</drawGUIOverlay>
    <tradeNeverStack>true</tradeNeverStack>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <Mass>0.75</Mass>
      <Bulk MayRequire="CETeam.CombatExtended">2.5</Bulk>
      <MarketValue>1000</MarketValue>
      <MaxHitPoints>80</MaxHitPoints>
    </statBases>
    <modExtensions>
      <li Class="MoreInjuries.Things.ReusabilityProps_ModExtension">
        <destroyChanceModifier Class="MoreInjuries.Things.Modifiers.ThingModifier_ConstantFactor">
          <factor>0.20</factor>
        </destroyChanceModifier>
      </li>
    </modExtensions>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>
</Defs>

