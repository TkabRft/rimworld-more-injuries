<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MIMedicalDeviceBase">
    <defName>Bandage</defName>
    <thingClass>ThingWithComps</thingClass>
    <label>bandage</label>
    <description>Temporarily reduces wound bleeding. Slower and less effective than a hemostatic agent; follow with proper treatment.</description>
    <graphicData>
      <texPath>Thing/Bandage</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>100</stackLimit>
    <tradeNeverStack>false</tradeNeverStack>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <Mass>0.05</Mass>
      <Bulk MayRequire="CETeam.CombatExtended">0.05</Bulk>
      <MarketValue>5</MarketValue>
      <MaxHitPoints>5</MaxHitPoints>
      <WorkToMake>50</WorkToMake>
    </statBases>
    <drawGUIOverlay>true</drawGUIOverlay>
    <modExtensions>
      <li Class="MoreInjuries.HealthConditions.HeavyBleeding.HemostasisModExtension">
        <coagulationMultiplier>0.2</coagulationMultiplier>
        <disappearsAfterTicks>30000</disappearsAfterTicks>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>