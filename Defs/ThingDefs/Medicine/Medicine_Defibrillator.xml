<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MIMedicalDeviceBase">
    <defName>Defibrillator</defName>
    <thingClass>ThingWithComps</thingClass>
    <label>defibrillator</label>
    <description>Attempts to restart the heart during a heart attack or early cardiac arrest. Later arrest requires CPR; a nonfunctional heart requires repair or replacement. Reusable, but may break after use.</description>
    <graphicData>
      <texPath>Thing/Defibrillator</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>10</stackLimit>
    <drawGUIOverlay>true</drawGUIOverlay>
    <tradeNeverStack>true</tradeNeverStack>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <Mass>0.5</Mass>
      <Bulk MayRequire="CETeam.CombatExtended">2</Bulk>
      <MarketValue>750</MarketValue>
      <MaxHitPoints>80</MaxHitPoints>
    </statBases>
    <modExtensions>
      <li Class="MoreInjuries.Things.ReusabilityProps_ModExtension">
        <destroyChanceModifier Class="MoreInjuries.Things.Modifiers.ThingModifier_Settings_Gauge">
          <key>DefibrillatorBreakOnUseRate</key>
        </destroyChanceModifier>
      </li>
    </modExtensions>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>
</Defs>

