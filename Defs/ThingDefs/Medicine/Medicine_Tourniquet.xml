<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MIMedicalDeviceBase">
    <defName>Tourniquet</defName>
    <thingClass>ThingWithComps</thingClass>
    <label>tourniquet</label>
    <description>Stops bleeding from a limb. Prolonged use risks gangrene and limb loss; remove once proper treatment is available.</description>
    <graphicData>
      <texPath>Thing/Tourniquet</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>75</stackLimit>
    <tradeNeverStack>false</tradeNeverStack>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <Mass>0.08</Mass>
      <Bulk MayRequire="CETeam.CombatExtended">0.08</Bulk>
      <MarketValue>5</MarketValue>
      <MaxHitPoints>5</MaxHitPoints>
      <WorkToMake>100</WorkToMake>
    </statBases>
    <drawGUIOverlay>true</drawGUIOverlay>
    <modExtensions>
      <li Class="MoreInjuries.HealthConditions.HeavyBleeding.HemostasisModExtension">
        <coagulationMultiplier>0.05</coagulationMultiplier>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>