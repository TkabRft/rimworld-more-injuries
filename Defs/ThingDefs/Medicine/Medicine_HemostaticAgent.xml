<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MIMedicalDeviceBase">
    <defName>HemostaticAgent</defName>
    <thingClass>ThingWithComps</thingClass>
    <label>hemostatic agent</label>
    <description>Quickly reduces severe wound bleeding. Temporary first aid; follow with proper treatment.</description>
    <graphicData>
      <texPath>Thing/Hemostat</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>75</stackLimit>
    <tradeNeverStack>false</tradeNeverStack>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <Mass>0.03</Mass>
      <Bulk MayRequire="CETeam.CombatExtended">0.03</Bulk>
      <MarketValue>6</MarketValue>
      <MaxHitPoints>5</MaxHitPoints>
      <WorkToMake>150</WorkToMake>
    </statBases>
    <drawGUIOverlay>true</drawGUIOverlay>
    <modExtensions>
      <li Class="MoreInjuries.HealthConditions.HeavyBleeding.HemostasisModExtension">
        <coagulationMultiplier>0.05</coagulationMultiplier>
        <disappearsAfterTicks>20000</disappearsAfterTicks>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>