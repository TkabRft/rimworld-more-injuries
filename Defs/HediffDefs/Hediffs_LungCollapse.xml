<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef ParentName="DiseaseBase">
    <defName>LungCollapse</defName>
    <label>lung collapse</label>
    <description>Impairs breathing; further lung injuries can worsen it. Below 45% severity, decent tending permits gradual recovery once lung bleeding stops. At 45% or above, surgery is required; tending cannot repair it. Severe collapse can cause cardiac arrest.</description>
    <defaultLabelColor>(255, 129, 56)</defaultLabelColor>
    <tendable>true</tendable>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>12</baseTendDurationHours>
      </li>
      <li Class="MoreInjuries.HealthConditions.LungCollapse.HediffCompProperties_LungCollapseResolution">
        <surgicalThreshold>0.45</surgicalThreshold>
        <severityPerDayTended>-0.15</severityPerDayTended>
        <minTendQuality>0.4</minTendQuality>
      </li>
      <li Class="MoreInjuries.HealthConditions.Secondary.HediffCompProperties_CausedBy"></li>
      <li Class="MoreInjuries.HealthConditions.Secondary.HediffCompProperties_SecondaryCondition">
        <severityCurve>
          <points>
            <li>0, 0</li>
            <li>0.2, 0</li>
            <li>0.45, 0.04</li>
            <li>0.75, 0.06</li>
            <li>0.9, 0.1</li>
            <li>1, 0.15</li>
          </points>
        </severityCurve>
        <handlers>
          <li Class="MoreInjuries.HealthConditions.Secondary.Handlers.HediffCompHandler_SecondaryCondition_Tick">
            <tickInterval>2000</tickInterval>
            <sendLetterWhenDiscovered>true</sendLetterWhenDiscovered>
            <chanceModifiers>
              <li Class="MoreInjuries.HealthConditions.Secondary.Handlers.Modifiers.HediffModifier_DisallowDeathResting"></li>
            </chanceModifiers>
            <hediffMakerProps Class="MoreInjuries.HealthConditions.Secondary.Handlers.HediffMakers.HediffMakerProperties_SingleHediff">
              <hediffMakerDef>
                <hediffDef>CardiacArrest</hediffDef>
                <minSeverity>0.001</minSeverity>
                <allowMultiple>false</allowMultiple>
                <allowDuplicate>false</allowDuplicate>
              </hediffMakerDef>
            </hediffMakerProps>
            <targetEvaluator Class="MoreInjuries.HealthConditions.Secondary.Handlers.TargetEvaluators.BodyPartHediffTargetEvaluator_Single">
              <target>Heart</target>
            </targetEvaluator>
          </li>
        </handlers>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <minSeverity>0</minSeverity>
        <partEfficiencyOffset>-0.05</partEfficiencyOffset>
        <painOffset>0.1</painOffset>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.2</minSeverity>
        <partEfficiencyOffset>-0.1</partEfficiencyOffset>
        <painOffset>0.3</painOffset>
        <capMods>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>tension</label>
        <minSeverity>0.45</minSeverity>
        <partEfficiencyOffset>-0.2</partEfficiencyOffset>
        <painOffset>0.4</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>severe tension</label>
        <minSeverity>0.75</minSeverity>
        <partEfficiencyOffset>-0.3</partEfficiencyOffset>
        <painOffset>0.5</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.35</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>extreme tension</label>
        <minSeverity>0.9</minSeverity>
        <partEfficiencyOffset>-0.4</partEfficiencyOffset>
        <painOffset>0.7</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.45</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
