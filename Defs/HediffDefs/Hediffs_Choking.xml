<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef ParentName="DiseaseBase">
    <defName>ChokingOnBlood</defName>
    <label>choking on blood</label>
    <description>Blood obstructs breathing and can cause fatal cerebral hypoxia. Stop bleeding and clear the airway with suction; CPR provides weaker emergency clearance. Conscious patients may cough it clear themselves.</description>
    <defaultLabelColor>(255, 102, 102)</defaultLabelColor>
    <tendable>false</tendable>
    <modExtensions>
      <li Class="MoreInjuries.HealthConditions.Secondary.HediffModifier_SeverityModifiers_ModExtension">
        <modifiers>
          <li MayRequire="Ludeon.RimWorld.Odyssey">
            <apply>OnIncrease</apply>
            <modifier Class="MoreInjuries.HealthConditions.Secondary.Handlers.Modifiers.HediffModifier_Genes_WhenPresent">
              <geneModifiers>
                <li>
                  <geneDef>VacuumResistance_Total</geneDef>
                  <modifier>0.05</modifier>
                </li>
              </geneModifiers>
            </modifier>
          </li>
        </modifiers>
      </li>
    </modExtensions>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>2.0</severityPerDay>
      </li>
      <li Class="HediffCompProperties_Discoverable">
        <sendLetterWhenDiscovered>false</sendLetterWhenDiscovered>
      </li>
      <li Class="HediffCompProperties_MessageAfterTicks">
        <ticks>10</ticks>
        <message>{0} is choking on blood!</message>
        <messageType>NegativeHealthEvent</messageType>
      </li>
      <li Class="MoreInjuries.HealthConditions.Secondary.HediffCompProperties_CausedBy"></li>
      <li Class="MoreInjuries.HealthConditions.Choking.HediffCompProperties_Choking">
        <chokingIntervalTicks>750</chokingIntervalTicks>
      </li>
    </comps>
    <stages>
      <li>
        <label>initial</label>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.95</setMax>
          </li>
        </capMods>
        <lifeThreatening>true</lifeThreatening>
      </li>
      <li>
        <minSeverity>0.15</minSeverity>
        <label>minor</label>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.85</setMax>
          </li>
        </capMods>
        <lifeThreatening>true</lifeThreatening>
      </li>
      <li>
        <minSeverity>0.30</minSeverity>
        <label>moderate</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.7</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.45</minSeverity>
        <label>severe</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.55</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.65</minSeverity>
        <label>very severe</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.35</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.70</minSeverity>
        <label>very severe</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.3</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.80</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.2</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.15</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.90</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.95</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.05</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>1.0</minSeverity>
        <label>lethal</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>ChokingOnTourniquet</defName>
    <label>choking on tourniquet</label>
    <description>A misapplied tourniquet is causing suffocation. Remove it immediately.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <makesSickThought>false</makesSickThought>
    <lethalSeverity>1</lethalSeverity>
    <tendable>false</tendable>
    <initialSeverity>0.001</initialSeverity>
    <removeOnRedressChanceByDaysCurve>
      <points>
        <li>(0, 1)</li>
        <li>(1, 1)</li>
      </points>
    </removeOnRedressChanceByDaysCurve>
    <modExtensions>
      <li Class="MoreInjuries.HealthConditions.Secondary.HediffModifier_SeverityModifiers_ModExtension">
        <modifiers>
          <li MayRequire="Ludeon.RimWorld.Odyssey">
            <apply>OnIncrease</apply>
            <modifier Class="MoreInjuries.HealthConditions.Secondary.Handlers.Modifiers.HediffModifier_Genes_WhenPresent">
              <geneModifiers>
                <li>
                  <geneDef>VacuumResistance_Total</geneDef>
                  <modifier>0.05</modifier>
                </li>
              </geneModifiers>
            </modifier>
          </li>
        </modifiers>
      </li>
    </modExtensions>
    <comps>
      <li Class="MoreInjuries.HealthConditions.HediffCompProperties_SeverityPerDay_WithModifiers">
        <severityPerDay>8.0</severityPerDay>
      </li>
      <li Class="HediffCompProperties_Discoverable">
        <sendLetterWhenDiscovered>false</sendLetterWhenDiscovered>
      </li>
      <li Class="MoreInjuries.HealthConditions.Secondary.HediffCompProperties_CausedBy"></li>
    </comps>
    <stages>
      <li>
        <label>struggling</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.5</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.1</minSeverity>
        <label>intermittent consciousness</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.25</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>unconscious</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.01</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
