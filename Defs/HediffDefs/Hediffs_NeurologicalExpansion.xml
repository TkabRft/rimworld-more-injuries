<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef ParentName="BrainDamageBase">
    <defName>MI_DiffuseBrainDamage</defName>
    <label>diffuse brain damage</label>
    <description>Lasting damage reduces brain efficiency and can cause a vegetative state. Does not ordinarily heal; advanced neurological treatment or suitable regeneration can restore function.</description>
    <chronic>true</chronic>
    <modExtensions>
      <li Class="MoreInjuries.HealthConditions.BrainDamage.NeurologicalConditionProperties"><animalEligible>true</animalEligible></li>
    </modExtensions>
    <stages>
      <li><label>minor</label><partEfficiencyOffset>-0.05</partEfficiencyOffset></li>
      <li><label>minor</label><minSeverity>0.2</minSeverity><partEfficiencyOffset>-0.15</partEfficiencyOffset></li>
      <li><label>major</label><minSeverity>0.4</minSeverity><partEfficiencyOffset>-0.30</partEfficiencyOffset></li>
      <li><label>major</label><minSeverity>0.6</minSeverity><partEfficiencyOffset>-0.50</partEfficiencyOffset></li>
      <li><label>extreme</label><minSeverity>0.8</minSeverity><partEfficiencyOffset>-0.75</partEfficiencyOffset></li>
      <li><label>vegetative state</label><minSeverity>1</minSeverity><partEfficiencyOffset>-0.75</partEfficiencyOffset><painFactor>0</painFactor><capMods><li><capacity>Consciousness</capacity><setMax>0.1</setMax></li></capMods></li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MI_ArtificialComa</defName>
    <label>artificial coma</label>
    <description>Halves new hypoxic brain injury; consciousness capped at 10%. Restore oxygen delivery separately. Wake-up reverses it when permitted. After about seven days, lasting injury becomes possible; about ten days is fatal. Re-induction does not reset this timer. Organ-failure timers and vacuum hazards remain active.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.001</initialSeverity><maxSeverity>1</maxSeverity><lethalSeverity>1</lethalSeverity>
    <everCurableByItem>false</everCurableByItem><duplicationAllowed>false</duplicationAllowed>
    <defaultLabelColor>(1, 0.35, 0.35)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay"><severityPerDay>0.1</severityPerDay></li>
      <li Class="MoreInjuries.HealthConditions.BrainDamage.HediffCompProperties_ArtificialComa" />
    </comps>
    <stages>
      <li><capMods><li><capacity>Consciousness</capacity><setMax>0.1</setMax></li></capMods></li>
      <li><label>dangerous</label><minSeverity>0.7</minSeverity><lifeThreatening>true</lifeThreatening><capMods><li><capacity>Consciousness</capacity><setMax>0.1</setMax></li></capMods></li>
      <li><label>life threatening</label><minSeverity>0.8</minSeverity><lifeThreatening>true</lifeThreatening><capMods><li><capacity>Consciousness</capacity><setMax>0.1</setMax></li></capMods></li>
    </stages>
  </HediffDef>
</Defs>
