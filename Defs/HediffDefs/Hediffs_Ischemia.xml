<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>TourniquetApplied</defName>
    <label>tourniquet</label>
    <description>Stops limb bleeding but cuts off its blood supply. Prolonged use risks gangrene and limb loss. Remove promptly once proper treatment is available.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(254, 221, 0)</defaultLabelColor>
    <initialSeverity>0.001</initialSeverity>
    <removeOnRedressChanceByDaysCurve>
      <points>
        <li>(0, 1)</li>
        <li>(1, 1)</li>
      </points>
    </removeOnRedressChanceByDaysCurve>
    <modExtensions>
      <li Class="MoreInjuries.HealthConditions.Secondary.HediffModifier_SeverityModifiers_ModExtension">
        <modifiers>
          <li MayRequire="Ludeon.RimWorld.Odyssey">
            <apply>OnIncrease</apply>
            <modifier Class="MoreInjuries.HealthConditions.Secondary.Handlers.Modifiers.HediffModifier_Genes_WhenPresent">
              <geneModifiers>
                <li>
                  <geneDef>VacuumResistance_Total</geneDef>
                  <modifier>0.05</modifier>
                </li>
              </geneModifiers>
            </modifier>
          </li>
        </modifiers>
      </li>
    </modExtensions>
    <comps>
      <li Class="MoreInjuries.HealthConditions.HediffCompProperties_SeverityPerDay_WithModifiers">
        <severityPerDay>1</severityPerDay>
      </li>
      <li Class="MoreInjuries.HealthConditions.HeavyBleeding.Tourniquets.HediffCompProperties_Tourniquet"></li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>restricted blood flow</label>
        <partEfficiencyOffset>-0.4</partEfficiencyOffset>
        <painOffset>0.05</painOffset>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>initial ischemia</label>
        <partEfficiencyOffset>-0.6</partEfficiencyOffset>
        <painOffset>0.1</painOffset>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>advanced ischemia</label>
        <lifeThreatening>true</lifeThreatening>
        <partEfficiencyOffset>-0.8</partEfficiencyOffset>
        <painOffset>0.2</painOffset>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>initial necrosis</label>
        <lifeThreatening>true</lifeThreatening>
        <partEfficiencyOffset>-0.9</partEfficiencyOffset>
        <painOffset>0.3</painOffset>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>advanced necrosis</label>
        <lifeThreatening>true</lifeThreatening>
        <partEfficiencyOffset>-1</partEfficiencyOffset>
        <painOffset>0.4</painOffset>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>TourniquetQuicklyRemoved</defName>
    <label>quickly removed tourniquet</label>
    <description>N/A</description>
    <maxSeverity>1</maxSeverity>
    <hediffClass>HediffWithComps</hediffClass>
    <modExtensions>
      <li Class="MoreInjuries.HealthConditions.Secondary.Linked.LinkedSeverityProperties_ModExtension">
        <modifiedHediffs>
          <li>
            <linkedHediffDef>Acidosis</linkedHediffDef>
            <severityModifiers>
              <li Class="MoreInjuries.HealthConditions.Secondary.Handlers.Modifiers.HediffModifier_ConstantFactor">
                <factor>0.25</factor>
              </li>
            </severityModifiers>
          </li>
        </modifiedHediffs>
      </li>
    </modExtensions>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
      </li>
      <li Class="MoreInjuries.HealthConditions.Secondary.HediffCompProperties_SecondaryCondition">
        <handlers>
          <li Class="MoreInjuries.HealthConditions.Secondary.Handlers.HediffCompHandler_SecondaryCondition_PostMake">
            <chanceModifiers>
              <li Class="MoreInjuries.HealthConditions.Secondary.Handlers.Modifiers.HediffModifier_Settings_FeatureFlag">
                <key>EnableAdvancedTraumaSimulation</key>
              </li>
            </chanceModifiers>
            <hediffMakerProps Class="MoreInjuries.HealthConditions.Secondary.Handlers.HediffMakers.HediffMakerProperties_SingleHediff">
              <hediffMakerDef>
                <hediffDef>Acidosis</hediffDef>
                <minSeverity>0.001</minSeverity>
                <allowMultiple>false</allowMultiple>
                <allowDuplicate>false</allowDuplicate>
              </hediffMakerDef>
            </hediffMakerProps>
          </li>
        </handlers>
      </li>
    </comps>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="DiseaseBase">
    <defName>GangreneDry</defName>
    <label>gangrene</label>
    <description>This tissue is irreversibly damaged. Amputate the affected part; untreated dry gangrene can become infected wet gangrene.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <maxSeverity>1</maxSeverity>
    <makesSickThought>true</makesSickThought>
    <defaultLabelColor>(189, 66, 46)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>1</severityPerDay>
      </li>
      <li>
        <compClass>MoreInjuries.HealthConditions.Gangrene.GangreneDryHediffComp</compClass>
      </li>
      <li Class="MoreInjuries.HealthConditions.Secondary.HediffCompProperties_CausedBy"></li>
    </comps>
    <stages>
      <li>
        <label>dry</label>
        <minSeverity>0</minSeverity>
        <partEfficiencyOffset>-1</partEfficiencyOffset>
        <painOffset>0.25</painOffset>
      </li>
    </stages>
    <injuryProps>
      <destroyedLabel>Fell off</destroyedLabel>
      <alwaysUseDestroyedLabel>true</alwaysUseDestroyedLabel>
    </injuryProps>
  </HediffDef>

  <HediffDef ParentName="DiseaseBase">
    <defName>GangreneWet</defName>
    <label>gangrene</label>
    <description>Infected dead tissue threatens the patient with fatal sepsis. Amputate the affected part urgently.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <makesSickThought>true</makesSickThought>
    <lethalSeverity>1</lethalSeverity>
    <defaultLabelColor>(189, 66, 46)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0.75</severityPerDay>
      </li>
      <li Class="MoreInjuries.HealthConditions.Secondary.HediffCompProperties_CausedBy"></li>
    </comps>
    <stages>
      <li>
        <label>septic</label>
        <minSeverity>0</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <partEfficiencyOffset>-1</partEfficiencyOffset>
        <painOffset>0.5</painOffset>
      </li>
    </stages> 
  </HediffDef>
</Defs>