<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ============= NEOLITHIC ============= -->
  <!-- unlocks: trepanation, splint, bandage-->
  <ResearchProjectDef>
    <defName>BasicAnatomy</defName>
    <label>basic anatomy</label>
    <description>Unlocks bandages, splints and basic fracture and stroke treatments.</description>
    <baseCost>500</baseCost>
    <techLevel>Neolithic</techLevel>
    <tags>
      <li>ClassicStart</li>
    </tags>
    <researchViewX>0</researchViewX>
    <researchViewY>0</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>

  <!-- ============= MEDIEVAL ============= -->
  <!-- depends on: basic anatomy -->
  <!-- unlocks: blood transfusion, tourniquet -->
  <ResearchProjectDef>
    <defName>BasicFirstAid</defName>
    <label>basic first aid</label>
    <description>Unlocks tourniquets, blood transfusions and blood collection.</description>
    <baseCost>1000</baseCost>
    <techLevel>Medieval</techLevel>
    <prerequisites>
      <li>BasicAnatomy</li>
      <li>Machining</li>
    </prerequisites>
    <researchViewX>1</researchViewX>
    <researchViewY>1</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>

  <!-- depends on: basic first aid -->
  <!-- unlocks: CPR -->
  <ResearchProjectDef>
    <defName>Cpr</defName>
    <label>cardiopulmonary resuscitation (CPR)</label>
    <description>Unlocks CPR to treat cardiac arrest and blood-obstructed airways. Draft a doctor and right-click the patient to order resuscitation.</description>
    <baseCost>500</baseCost>
    <techLevel>Industrial</techLevel>
    <tags>
      <li>ClassicStart</li>
    </tags>
    <prerequisites>
      <li>BasicAnatomy</li>
    </prerequisites>
    <researchViewX>1</researchViewX>
    <researchViewY>0</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>

  <!-- depends on: basic first aid, medicine production -->
  <!-- unlocks: hemostatic agent -->
  <ResearchProjectDef>
    <defName>AdvancedFirstAid</defName>
    <label>advanced first aid</label>
    <description>Unlocks hemostatic agents for faster, more effective bleeding control than bandages.</description>
    <baseCost>1500</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>BasicFirstAid</li>
      <li>DrugProduction</li>
    </prerequisites>
    <researchViewX>2</researchViewX>
    <researchViewY>1</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>

  <!-- depends on: basic first aid -->
  <!-- unlocks: morphine autoinjector -->
  <ResearchProjectDef>
    <defName>MorphineSynthesis</defName>
    <label>morphine synthesis</label>
    <description>Unlocks morphine autoinjectors for pain relief. Morphine can impair breathing and resuscitation, especially during severe blood loss.</description>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>BasicFirstAid</li>
      <li>DrugProduction</li>
    </prerequisites>
    <researchViewX>2</researchViewX>
    <researchViewY>2</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>

  <!-- depends on: basic first aid, drug production -->
  <!-- unlocks: chloroform synthesis -->
  <ResearchProjectDef>
    <defName>ChloroformSynthesis</defName>
    <label>chloroform synthesis</label>
    <description>Unlocks chloroform for sedation. Excessive dosing risks overdose and organ damage.</description>
    <baseCost>750</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>BasicFirstAid</li>
      <li>DrugProduction</li>
    </prerequisites>
    <researchViewX>2</researchViewX>
    <researchViewY>3</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>
  
  <!-- ============= INDUSTRIAL ============= -->
  <!-- depends on: basic first aid -->
  <!-- unlocks: defibrillator, saline IVs, airway suction device, decompressive craniectomy, osteosynthetic surgery, thoracotomy -->
  <ResearchProjectDef>
    <defName>EmergencyMedicine</defName>
    <label>emergency medicine</label>
    <description>Unlocks emergency equipment, including defibrillators and airway suction devices.</description>
    <baseCost>2000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>Cpr</li>
      <li>BasicFirstAid</li>
      <li>Electricity</li>
    </prerequisites>
    <researchViewX>2</researchViewX>
    <researchViewY>0</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>

  <!-- depends on: emergency medicine -->
  <!-- unlocks: stereotactic surgery -->
  <ResearchProjectDef>
    <defName>Neurosurgery</defName>
    <label>neurosurgery</label>
    <description>Unlocks advanced surgery to repair hemorrhagic strokes.</description>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>3000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>EmergencyMedicine</li>
      <li>Fabrication</li>
    </prerequisites>
    <researchViewX>3</researchViewX>
    <researchViewY>0</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>

  <!-- depends on: emergency medicine -->
  <!-- unlocks: thoracoscope, video-assisted thoracoscopic surgery -->
  <ResearchProjectDef>
    <defName>AdvancedThoracicSurgery</defName>
    <label>advanced thoracic surgery</label>
    <description>Unlocks thoracoscopes and advanced collapsed-lung repair.</description>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>2500</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>EmergencyMedicine</li>
      <li>VitalsMonitor</li>
    </prerequisites>
    <researchViewX>3</researchViewX>
    <researchViewY>1</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>

  <!-- depends on: emergency medicine, medicine production -->
  <!-- unlocks: epinephrine autoinjector -->
  <ResearchProjectDef>
    <defName>EpinephrineSynthesis</defName>
    <label>epinephrine synthesis</label>
    <description>Unlocks epinephrine autoinjectors. Adrenaline temporarily supports shock treatment and boosts movement, but does not replace lost blood.</description>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <baseCost>1500</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>EmergencyMedicine</li>
      <li>DrugProduction</li>
    </prerequisites>
    <researchViewX>3</researchViewX>
    <researchViewY>2</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>

  <!-- depends on: drug production -->
  <!-- unlocks: ketamine synthesis for auto-injectors -->
  <ResearchProjectDef>
    <defName>KetamineSynthesis</defName>
    <label>ketamine synthesis</label>
    <description>Unlocks ketamine for pain relief and sedation. Repeated doses can cause dangerous drug buildup and overdose.</description>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <baseCost>2000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>DrugProduction</li>
      <li>EmergencyMedicine</li>
      <li>ChloroformSynthesis</li>
    </prerequisites>
    <researchViewX>3</researchViewX>
    <researchViewY>3</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>

  <!-- ============= SPACER ============= -->
  <!-- depends on: emergency medicine -->
  <!-- unlocks: cellular regenerative surgery -->
  <ResearchProjectDef>
    <defName>CellularRegeneration</defName>
    <label>cellular regenerative medicine</label>
    <description>Unlocks regenerative treatments for hearing loss, spinal paralysis and neurological damage.</description>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>4000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>Neurosurgery</li>
      <li>Bionics</li>
    </prerequisites>
    <researchViewX>4</researchViewX>
    <researchViewY>0</researchViewY>
    <tab>MIResearchTab</tab>
  </ResearchProjectDef>
</Defs>